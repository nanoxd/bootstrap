#!/bin/bash

fancy_echo() {
  local fmt="$1"; shift

  printf "\n$fmt\n" "$@"
}

append_to_zshrc() {
  local text="$1" zshrc
  local skip_new_line="${2:-0}"

  if [ -w "$HOME/.zshrc.local" ]; then
    zshrc="$HOME/.zshrc.local"
  else
    zshrc="$HOME/.zshrc"
  fi

  if ! grep -Fqs "$text" "$zshrc"; then
    if [ "$skip_new_line" -eq 1 ]; then
      printf "%s\n" "$text" >> "$zshrc"
    else
      printf "\n%s\n" "$text" >> "$zshrc"
    fi
  fi
}

trap 'ret=$?; test $ret -ne 0 && printf "failed\n\n" >&2; exit $ret' EXIT

set -e

BOOTSTRAP_PROFILE="${BOOTSTRAP_PROFILE:-personal}"
export BOOTSTRAP_PROFILE
fancy_echo "Bootstrapping with profile: $BOOTSTRAP_PROFILE"

if [ ! -d "$HOME/.bin/" ]; then
  mkdir "$HOME/.bin"
fi

if [ ! -f "$HOME/.zshrc" ]; then
  touch "$HOME/.zshrc"
fi

append_to_zshrc 'export PATH="$HOME/.bin:$PATH"'
export PATH="$HOME/.bin:$PATH"

softwareupdate --install-rosetta --agree-to-license 2>/dev/null || true

if [ ! -x /opt/homebrew/bin/brew ]; then
  # Empty out dock
  defaults write com.apple.dock persistent-apps -array
  fancy_echo "Installing Homebrew ..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

    append_to_zshrc '# recommended by brew doctor'
    append_to_zshrc 'export PATH="/opt/homebrew/bin:$PATH"' 1
    export PATH="/opt/homebrew/bin:$PATH"
else
  fancy_echo "Homebrew already installed. Skipping ..."
fi

fancy_echo "Updating Homebrew formulas ..."
brew update

make brew

brew services restart goku 2>/dev/null || true

if [ ! -x "$HOME/.bin/xcodes" ]; then
  fancy_echo "Installing xcodes CLI ..."
  xcodes_url="$(curl -fsSL https://api.github.com/repos/XcodesOrg/xcodes/releases/latest \
    | grep browser_download_url \
    | grep 'macos.arm64.tar.gz' \
    | cut -d'"' -f4)"
  curl -fsSL "$xcodes_url" -o /tmp/xcodes.tar.gz
  tar -xzf /tmp/xcodes.tar.gz -C /tmp/
  mv /tmp/xcodes/*/bin/xcodes "$HOME/.bin/xcodes"
  chmod +x "$HOME/.bin/xcodes"
  /bin/rm -rf /tmp/xcodes.tar.gz /tmp/xcodes
fi

fancy_echo "Installing latest Xcode ..."
if [ -z "$(xcodes installed 2>/dev/null)" ]; then
  xcodes install --latest --experimental-unxip --select
else
  fancy_echo "Xcode already installed. Skipping ..."
fi

fish_path="$(which fish)"
if ! grep -Fq "$fish_path" /etc/shells; then
  fancy_echo "Adding fish to /etc/shells"
  echo "$fish_path" | sudo tee -a /etc/shells
fi

if [ "$SHELL" != "$fish_path" ]; then
  fancy_echo "Changing your shell to fish ..."
  chsh -s "$fish_path"
fi

# Logs in to GitHub, generates the SSH key if needed, registers it, and
# configures SSH commit signing. Must run before dotfiles, which clone over SSH.
./git-signing

fancy_echo "Installing Rust"
if [ ! -e "$HOME/.cargo/bin" ]; then
  curl https://sh.rustup.rs -sSf | sh
  append_to_zshrc 'export PATH="$HOME/.cargo/bin:$PATH"' 1

  source $HOME/.cargo/env
  rustup default stable
  rustup component add rust-analyzer rustfmt clippy
fi

make rust

if [ ! -d "$HOME/.dotfiles/" ]; then
  cargo install --git https://github.com/ubnt-intrepid/dot.git
  dot init nanoxd/dotfiles
fi

fancy_echo "Symlinking diff-highlight from brew git ..."
diff_hl="$(brew --prefix git)/share/git-core/contrib/diff-highlight/diff-highlight"
if [ -x "$diff_hl" ] && [ ! -e "$HOME/.bin/diff-highlight" ]; then
  ln -sf "$diff_hl" "$HOME/.bin/diff-highlight"
fi
