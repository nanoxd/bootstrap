#!/bin/bash

fancy_echo() {
  local fmt="$1"; shift

  printf "\n$fmt\n" "$@"
}

trap 'ret=$?; test $ret -ne 0 && printf "failed\n\n" >&2; exit $ret' EXIT

set -e

# server installs the base Brewfile only. personal adds Brewfile.personal.
BOOTSTRAP_PROFILE="${BOOTSTRAP_PROFILE:-server}"
case "$BOOTSTRAP_PROFILE" in
  server|personal) ;;
  *) printf "Unknown BOOTSTRAP_PROFILE: %s (use server or personal)\n" "$BOOTSTRAP_PROFILE" >&2; exit 1 ;;
esac
export BOOTSTRAP_PROFILE
fancy_echo "Bootstrapping with profile: $BOOTSTRAP_PROFILE"

BOOTSTRAP_DIR="$(cd "$(dirname "$0")" && pwd)"
BOOTSTRAP_REPO="nanoxd/bootstrap"
DOTFILES="$HOME/.dotfiles"
DOTFILES_REPO="nanoxd/dotfiles"

# Shell startup files belong to the dotfiles, so this script only sets PATH for
# itself and never writes to ~/.zshrc or the fish config.
export PATH="$HOME/.bin:$HOME/.cargo/bin:$PATH"

softwareupdate --install-rosetta --agree-to-license 2>/dev/null || true

if [ ! -x /opt/homebrew/bin/brew ]; then
  # Empty out dock
  defaults write com.apple.dock persistent-apps -array
  fancy_echo "Installing Homebrew ..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
else
  fancy_echo "Homebrew already installed. Skipping ..."
fi
eval "$(/opt/homebrew/bin/brew shellenv)"
brew analytics off

fancy_echo "Enabling the application firewall ..."
socketfilterfw=/usr/libexec/ApplicationFirewall/socketfilterfw
if ! "$socketfilterfw" --getglobalstate | grep -q 'State = [12]'; then
  sudo "$socketfilterfw" --setglobalstate on
fi

# Homebrew's installer only brings the Command Line Tools. Some formulas need
# full Xcode to build or link, so switch to it before the Brewfile runs.
fancy_echo "Installing latest Xcode ..."
for formula in xcodes aria2; do
  if ! brew list --formula "$formula" >/dev/null 2>&1; then
    brew install "$formula"
  fi
done

if [ -z "$(xcodes installed 2>/dev/null)" ]; then
  xcodes install --latest --experimental-unxip --select
else
  fancy_echo "Xcode already installed. Skipping ..."
fi

# An Xcode installed some other way, such as the App Store, leaves the Command
# Line Tools selected. Pick the newest release, falling back to a beta.
if xcode-select -p 2>/dev/null | grep -Fq CommandLineTools; then
  xcode_path="$(xcodes installed | grep -vi beta | tail -1 | awk -F'\t' '{ print $NF }')"
  if [ -z "$xcode_path" ]; then
    xcode_path="$(xcodes installed | tail -1 | awk -F'\t' '{ print $NF }')"
  fi
  fancy_echo "Selecting %s ..." "$xcode_path"
  sudo xcode-select --switch "$xcode_path"
fi

if ! xcodebuild -license check >/dev/null 2>&1; then
  fancy_echo "Accepting the Xcode license ..."
  sudo xcodebuild -license accept
fi

if ! xcodebuild -checkFirstLaunchStatus >/dev/null 2>&1; then
  fancy_echo "Installing Xcode first-launch components ..."
  sudo xcodebuild -runFirstLaunch
fi

fancy_echo "Installing Rust ..."
if [ ! -x "$HOME/.cargo/bin/rustup" ]; then
  # --no-modify-path keeps rustup out of the shell startup files, which the
  # dotfiles own and have not been linked yet.
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --no-modify-path --default-toolchain stable
else
  fancy_echo "rustup already installed. Skipping ..."
fi
rustup component add rust-analyzer rustfmt clippy

# Prints "name<TAB>target" for each link the dotfiles make on macOS.
dotfile_mappings() {
  awk -F' = ' '
    /^\[/ { section = $0; next }
    /^#/ || NF != 2 { next }
    section == "[general]" || section == "[darwin]" {
      gsub(/"/, "", $1); gsub(/"/, "", $2); print $1 "\t" $2
    }' "$DOTFILES/.mappings"
}

# dot link renames anything already sitting at a link target, so a ~/.config
# that an app created first would lose its contents, such as gh's login.
# Merge those directories into the repo without overwriting tracked files, then
# move the originals aside so dot can link in their place.
make_room_for_dotfiles() {
  local name target source backup

  dotfile_mappings | while IFS="$(printf '\t')" read -r name target; do
    target="$HOME/${target#\~/}"
    source="$DOTFILES/$name"

    if [ -L "$target" ] || [ ! -e "$target" ] || [ ! -e "$source" ]; then
      continue
    fi

    if [ -d "$target" ] && [ -d "$source" ]; then
      fancy_echo "Merging existing %s into the dotfiles ..." "$target"
      rsync -a --ignore-existing "$target/" "$source/"
    fi

    backup="$target.pre-dotfiles.$(date +%Y%m%d%H%M%S)"
    fancy_echo "Moving existing %s to %s ..." "$target" "$backup"
    mv "$target" "$backup"
  done
}

# Cloned over HTTPS because the SSH key isn't on GitHub yet. git-signing needs
# user.email from these dotfiles, so it runs later and the remote switches to
# SSH afterwards.
fancy_echo "Linking dotfiles ..."
if [ ! -d "$DOTFILES" ]; then
  git clone "https://github.com/$DOTFILES_REPO.git" "$DOTFILES"
fi
if ! command -v dot >/dev/null 2>&1; then
  cargo install --git https://github.com/ubnt-intrepid/dot.git
fi
make_room_for_dotfiles
dot link

fancy_echo "Updating Homebrew formulas ..."
brew update

make brew

brew services restart goku 2>/dev/null || true

fish_path="$(which fish)"
if ! grep -Fq "$fish_path" /etc/shells; then
  fancy_echo "Adding fish to /etc/shells"
  echo "$fish_path" | sudo tee -a /etc/shells
fi

if [ "$SHELL" != "$fish_path" ]; then
  fancy_echo "Changing your shell to fish ..."
  chsh -s "$fish_path"
fi

# Logs in to GitHub, generates the SSH key if needed, registers it, and
# configures SSH commit signing.
./git-signing

# install and the dotfiles step clone over HTTPS because no SSH key exists yet.
use_ssh_remote() {
  local dir="$1" repo="$2"

  if git -C "$dir" remote get-url origin | grep -q '^https://github.com/'; then
    fancy_echo "Switching the %s remote to SSH ..." "$repo"
    git -C "$dir" remote set-url origin "git@github.com:$repo.git"
  fi
}

use_ssh_remote "$DOTFILES" "$DOTFILES_REPO"
use_ssh_remote "$BOOTSTRAP_DIR" "$BOOTSTRAP_REPO"

make rust
