#!/bin/bash
#
# Entry point for a fresh Mac. Installs the Command Line Tools, which bring git,
# clones or updates this repo, and runs make install:
#
#   /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/nanoxd/bootstrap/main/install)"
#
# Run it that way rather than piping curl into bash, so the prompts in setup
# (sudo, Apple ID, GitHub login, SSH passphrase) can read from the terminal.
# Re-running it is how a machine gets updated: it fast-forwards the checkout
# and runs everything again, which is safe because every step is idempotent.

fancy_echo() {
  local fmt="$1"; shift

  printf "\n$fmt\n" "$@"
}

trap 'ret=$?; test $ret -ne 0 && printf "failed\n\n" >&2; exit $ret' EXIT

set -e

# Install the password manager before tools that need account credentials.
# Keep the desktop app on its own updater, outside Homebrew.
if [ "${BOOTSTRAP_PROFILE:-server}" = personal ]; then
  if [ ! -d /Applications/1Password.app ] && [ ! -d "$HOME/Applications/1Password.app" ]; then
    printf '\nInstall 1Password from https://1password.com/downloads/mac/ and sign in.\n'
    if [ ! -t 0 ]; then
      printf 'Rerun bootstrap in a terminal after installing 1Password.\n' >&2
      exit 1
    fi
    open https://1password.com/downloads/mac/
    while [ ! -d /Applications/1Password.app ] && [ ! -d "$HOME/Applications/1Password.app" ]; do
      read -r -p 'Press Return once 1Password is installed and ready: ' _
    done
  fi
fi

BOOTSTRAP_DIR="${BOOTSTRAP_DIR:-$HOME/dev/bootstrap}"
BOOTSTRAP_REPO="nanoxd/bootstrap"

if ! xcode-select -p >/dev/null 2>&1; then
  fancy_echo "Installing the Command Line Tools. Click Install in the dialog ..."
  xcode-select --install
  until xcode-select -p >/dev/null 2>&1; do
    sleep 5
  done
else
  fancy_echo "Command Line Tools already installed. Skipping ..."
fi

if [ ! -d "$BOOTSTRAP_DIR/.git" ]; then
  fancy_echo "Cloning %s into %s ..." "$BOOTSTRAP_REPO" "$BOOTSTRAP_DIR"
  mkdir -p "$(dirname "$BOOTSTRAP_DIR")"
  git clone "https://github.com/$BOOTSTRAP_REPO.git" "$BOOTSTRAP_DIR"
else
  fancy_echo "Updating %s ..." "$BOOTSTRAP_DIR"
  git -C "$BOOTSTRAP_DIR" pull --ff-only
fi

cd "$BOOTSTRAP_DIR"
exec make install
